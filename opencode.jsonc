{
  "$schema": "https://opencode.ai/config.json",
  // Cloud-first default; swap for any configured provider/model:
  //   "deepseek/deepseek-chat"       (DeepSeek V4.1 Flash)
  //   "google/gemini-4-hydrogen"     (Gemini 4 Hydrogen)
  //   "google/gemini-3.8-flash"      (Gemini 3.8 Flash)
  //   "anthropic/claude-haiku-4-5"   (Claude Haiku)
  //   "qwen/qwen3-coder"             (Qwen3-Coder)
  "model": "google/gemini-4-hydrogen",
  // Optional local models (for local-first setups, pi-dev-skills is recommended):
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "thinkingmachines/inkling-2-mini": {
          "name": "Inkling 2 Mini",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "reasoning_effort": "none"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "off": {
              "reasoning_effort": "none"
            },
            "on": {
              "reasoning_effort": "medium"
            }
          }
        },
        "prism-ml/bonsai-27b": {
          "name": "Prism Bonsai 27B",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "reasoning_effort": "none"
          },
          "variants": {
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
            "off": {
              "reasoning_effort": "none"
            },
            "on": {
              "reasoning_effort": "medium"
            }
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "temperature": 0,
      "permission": {
        "skill": {
          "dev-plan": "ask",
          "dev-plan-manual": "ask",
          "dev-research": "ask",
          "dev-audit": "ask"
        }
      }
    },
    "plan": {
      "temperature": 0,
      "permission": {
        "edit": {
          "*.md": "allow",
          "**/*.md": "allow",
          ".tasks/**": "allow",
          "plans/**": "allow"
        },
        "skill": {
          "dev-implement": "deny",
          "dev-fix": "deny",
          "dev-pr": "deny",
          "dev-pr-resolve": "deny"
        }
      }
    }
  }
}
